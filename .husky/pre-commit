#!/bin/bash

# Colors for highlighting
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

# Hide/show cursor escape sequences
HIDE_CURSOR='\033[?25l'
SHOW_CURSOR='\033[?25h'

printf "%b↻  Performing precommit checks ...%b\n" "$CYAN" "$RESET"
printf "%b🗲  Formatting unformatted files...%b\n" "$YELLOW" "$RESET"
printf "%bRunning lint-staged...%b\n" "$GREEN" "$RESET"

# Hide cursor
printf "%b" "$HIDE_CURSOR"

# Run lint-staged and capture its output
LINT_OUTPUT=$(npx lint-staged 2>&1)
RESULT=$?

# Kill the animation process safely
kill "$ANIMATION_PID" 2>/dev/null
wait "$ANIMATION_PID" 2>/dev/null

# Clear the animation line
printf "\r\033[K"

# Display the results with highlighting
if [ $RESULT -eq 0 ]; then
  printf "%b✓ Lint-staged completed successfully%b\n" "$GREEN" "$RESET"
else
  printf "%b⚠ Lint-staged found issues:%b\n" "$YELLOW" "$RESET"
fi

# Print the output with highlighting
echo "$LINT_OUTPUT" | sed -E "s/(\[.*\])/${CYAN}\1${RESET}/g" \
  | sed -E "s/(✓.*|success.*)/${GREEN}\1${RESET}/g" \
  | sed -E "s/(✖.*|error.*|failed.*)/${YELLOW}\1${RESET}/g"

exit $RESULT
