#!/bin/sh

# Colors for highlighting
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

printf "%b✅ Performing precommit checks ...%b\n" "$CYAN" "$RESET"
printf "%b⚡ Formatting unformatted files...%b\n" "$YELLOW" "$RESET"
printf "%b🔍 Running lint-staged...%b\n" "$GREEN" "$RESET"

# Run lint-staged (auto formats & lints staged files)
npx lint-staged --quiet

# If lint-staged failed, block commit
if [ $? -ne 0 ]; then
  echo "❌ Commit blocked due to linting errors."
  exit 1
fi

echo ""
echo "✅ All checks passed. Proceeding with commit."
echo ""
exit 0
